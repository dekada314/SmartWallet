@startuml
skinparam defaultFontName Arial
skinparam backgroundColor white

title ER-диаграмма основной базы знаний «Умный кошелёк»

entity "Category\n(Категория)" as CAT {
  * идентификатор : string <<PK>>
  --
  * название : string
  * обязательная : boolean
  * приоритет : integer [1..5]
  родитель : string <<FK>>
}

entity "Keyword\n(Ключевое слово)" as KW {
  * слово : string <<PK>>
  --
  * идентификатор_категории : string <<FK>>
}

entity "Rule\n(Правило)" as RULE {
  * идентификатор : string <<PK>>
  --
  * условие : string
  * текст : string
}

entity "TrainingExample\n(Обучающий пример)" as TR {
  * текст : string <<PK>>
  --
  * идентификатор_категории : string <<FK>>
}

entity "MLModel\n(ML-модель)" as ML {
  * путь_к_модели : string <<PK>>
  --
  * путь_к_векторизатору : string
}

CAT ||--o{ CAT
CAT ||--o{ KW
CAT ||--o{ RULE
CAT ||--o{ TR
TR }o--|| ML

@enduml