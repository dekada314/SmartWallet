@startuml
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam backgroundColor white

title Место базы знаний советов\nв архитектуре системы «Умный кошелёк»

actor "Пользователь" as User
actor "Разработчик\n(эксперт)" as Developer

package "Telegram Бот" {

    [Обработчики\n(интерфейс)] as Handlers

    package "Бизнес-логика" {
        [Сценарий добавления траты] as AddExpenseUseCase
        [Сценарий выдачи совета] as GiveAdviceUseCase
        [Сценарий уведомления] as NotificationUseCase
    }

    package "Классификация" {
        [Репозиторий категорий YAML] as YamlCategoriesRepository
        [Классификатор] as SkClassifier
    }

    package "Сервисы" {
        [Планировщик] as Scheduler
    }

    database "transactions_db\n.sqlite3" as TransactionDB
    database "users_db\n.sqlite3" as UserDB
}

package "База знаний советов" {
    file "advices.yml" as AdviceKnowledgeBase
}

package "Основная БЗ" {
    file "knowledge_base.yml" as KnowledgeBase
}

User --> Handlers : ввод транзакции /\nзапрос совета
Developer --> AdviceKnowledgeBase : пополнение\nсоветами

Handlers --> AddExpenseUseCase
Handlers --> GiveAdviceUseCase
Handlers --> NotificationUseCase

AddExpenseUseCase --> YamlCategoriesRepository
AddExpenseUseCase --> SkClassifier
AddExpenseUseCase --> TransactionDB
AddExpenseUseCase --> UserDB

YamlCategoriesRepository --> KnowledgeBase
SkClassifier --> KnowledgeBase

AddExpenseUseCase --> GiveAdviceUseCase : категория\nтранзакции

GiveAdviceUseCase --> AdviceKnowledgeBase : выборка совета\nпо категории
GiveAdviceUseCase --> TransactionDB : анализ\nистории трат

Scheduler --> GiveAdviceUseCase : плановый\nзапрос совета

@enduml