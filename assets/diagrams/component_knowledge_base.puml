@startuml
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam backgroundColor white

title Архитектура системы «Умный кошелёк»\nМесто основной базы знаний

actor "Пользователь" as User

package "Telegram Бот" {

    package "Интерфейс" {
        [Обработчики] as Handlers
        [Клавиатуры] as Keyboards
    }

    package "Бизнес-логика" {
        [Сценарии использования] as UseCases
    }

    package "Классификация" {
        [Репозиторий категорий YAML] as YamlCategoriesRepository
        [Классификатор\n(TF-IDF + Логистическая регрессия)] as SkClassifier
    }

    package "Сервисы" {
        [Обработка текста] as TextProcessing
        [Парсер чеков] as ReceiptParser
        [Планировщик] as Scheduler
    }

    package "Хранилище оперативных данных" {
        database "users_db.sqlite3" as UserDB
        database "transactions_db.sqlite3" as TransactionDB
        database "goals_db.sqlite3" as GoalDB
    }
}

package "База знаний (предмет работы)" {
    file "knowledge_base.yml\n(онтология, лексикон, правила)" as KnowledgeBase
    file "dataset.csv\n(обучающая выборка)" as Dataset
    file "model.joblib\n(веса модели)" as Model
}

User --> Handlers : сообщения / кнопки
Handlers --> UseCases
Handlers --> Keyboards
UseCases --> YamlCategoriesRepository : поиск по лексикону
UseCases --> SkClassifier : классификация
UseCases --> TextProcessing : предобработка текста
UseCases --> ReceiptParser : разбор чека
UseCases --> Scheduler : уведомления
UseCases --> UserDB
UseCases --> TransactionDB
UseCases --> GoalDB

YamlCategoriesRepository --> KnowledgeBase : чтение лексикона\nи онтологии
SkClassifier --> KnowledgeBase : чтение правил
SkClassifier --> Dataset : чтение датасета
SkClassifier --> Model : загрузка весов

@enduml